{
  "name": "hasere",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.18.0"
  },
  "description": "KKTC haşere ilaçlama — SEO, dönüşüm ve AI arama optimizasyonu",
  "scripts": {
    "dev": "next dev --turbopack --hostname 0.0.0.0 --port 3020",
    "dev:clean": "rm -rf .next && next dev --turbopack --hostname 0.0.0.0 --port 3020",
    "start:prod": "next build && next start --hostname 0.0.0.0 --port 3020",
    "optimize:images": "node scripts/optimize-service-images.mjs",
    "build": "npm run optimize:images && next build",
    "start": "next start",
    "lint": "next lint",
    "audit:check": "npm audit --audit-level=moderate"
  },
  "dependencies": {
    "next": "^15.5.0",
    "next-intl": "^4.13.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "critters": "^0.0.23",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.5.0",
    "postcss": "^8.5.10",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0"
  },
  "overrides": {
    "postcss": "^8.5.10"
  }
}
